    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Play Flappy", "short_name": "Play", "url": "./index.html?mode=classic", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Daily Run", "short_name": "Daily", "url": "./index.html?mode=daily", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ]
